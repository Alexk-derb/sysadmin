#!/usr/bin/env bash
# .githooks/pre-commit — версионируемый pre-commit hook репо sysadmin.
#
# ЗАЧЕМ. Две независимые проверки целостности перед коммитом:
#  1) ПЕРСОНА (CLAUDE.md ↔ references/*.md; ADR-0015) — рассинхрон слоёв = неправильное
#     действие агента на старте (инциденты v1.9.1–v1.9.3). + бюджет ядра CLAUDE.md (ADR-0016).
#  2) ЗНАНИЯ (.claude/knowledge/) — целостность базы: валидный frontmatter (иначе файл
#     невидим для контроля свежести), битые путевые ссылки, сироты (ADR-0003/0006).
#
# Хук версионируется (лежит в репо), активируется один раз:
#   git config core.hooksPath .githooks
# Эту строку добавляют sysadmin-init / bootstrap-new-server при настройке.
#
# Обход в исключительном случае (НЕ по привычке): git commit --no-verify

set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
STAGED="$(git diff --cached --name-only --diff-filter=ACMRDT 2>/dev/null)"  # D и T тоже: удаление reference и подмена файла ссылкой — тоже правка персоны
FAIL=0

# ===========================================================================
# 1. ПЕРСОНА — бюджет ядра + синхрон слоёв (только если коммит трогает персону)
# ===========================================================================
PERSONA_TOUCHED=0
case "$STAGED" in *"CLAUDE.md"*)                  PERSONA_TOUCHED=1 ;; esac  # ядро (ADR-0015)
case "$STAGED" in *".claude/agents/sysadmin.md"*) PERSONA_TOUCHED=1 ;; esac  # legacy/заглушка
case "$STAGED" in *".claude/agents/references/"*) PERSONA_TOUCHED=1 ;; esac
case "$STAGED" in *".claude/skills/_lib/check-persona-sync.sh"*) PERSONA_TOUCHED=1 ;; esac  # сам линтер
case "$STAGED" in *".githooks/"*)                 PERSONA_TOUCHED=1 ;; esac  # сами хуки
case "$STAGED" in *".gitattributes"*)             PERSONA_TOUCHED=1 ;; esac  # LF-контракт ядра
# Сторож обязан охранять и себя: правка линтера, хуков или .gitattributes раньше не
# включала проверки, и мутант «линтер = exit 0» проходил (сверка 2026-08-20).

if [ "$PERSONA_TOUCHED" -eq 1 ]; then
    # --- бюджет ядра CLAUDE.md (ADR-0016, анти-храповик) -------------------
    CLAUDE_BUDGET_BYTES=42000
    CLAUDEMD="$ROOT/CLAUDE.md"
    case "$STAGED" in
        *"CLAUDE.md"*)
            if [ -f "$CLAUDEMD" ]; then
                # Канонический размер — тот, что уходит в репозиторий: staged-блоб уже
                # прошёл clean-фильтр, значит LF. Сырой `wc -c` рабочей копии на Windows
                # завышает на число строк (CRLF) и делает порог платформозависимым —
                # правка, проходящая на сервере, падала бы на ноутбуке (ADR-0023).
                BYTES="$(git cat-file -s :CLAUDE.md 2>/dev/null)"
                [ -n "$BYTES" ] || BYTES="$(tr -d '\r' < "$CLAUDEMD" | wc -c | tr -d ' ')"
                if [ "$BYTES" -gt "$CLAUDE_BUDGET_BYTES" ]; then
                    echo "❌ pre-commit: CLAUDE.md = ${BYTES} Б > бюджет ${CLAUDE_BUDGET_BYTES} Б (ADR-0016)." >&2
                    echo "   Ядро грузится при каждом старте. Вынеси часть в references/ («одно входит — одно выходит»)," >&2
                    echo "   либо подними бюджет осознанно через ADR. Обход (редко): git commit --no-verify" >&2
                    FAIL=1
                fi
            fi
            ;;
    esac

    # --- линтер согласованности слоёв — ПО STAGED-СНИМКУ, включая сам линтер ---
    # Рабочее дерево и индекс расходятся, и это касается не только персоны, но и
    # сторожа: можно положить в индекс «exit 0», оставить исправный линтер на диске,
    # пройти приманку рабочим линтером и закоммитить сломанный (сверка 2026-08-20).
    # Поэтому индекс выгружается целиком, и запускается ИМЕННО ТОТ линтер, что уходит
    # в коммит. Нет его в индексе — отказ, а не предупреждение с продолжением.
    SNAP="$(mktemp -d)"
    if ! git checkout-index -a --prefix="$SNAP/" 2>/dev/null; then
        echo "❌ pre-commit: не удалось выгрузить индекс во временный каталог — проверка не выполнена." >&2
        FAIL=1
    else
        LINTER="$SNAP/.claude/skills/_lib/check-persona-sync.sh"
        if [ ! -f "$LINTER" ]; then
            echo "❌ pre-commit: персона меняется, но линтера нет в индексе — коммит уедет без сторожа." >&2
            FAIL=1
        else
            echo "pre-commit: коммит трогает персону → проверяю согласованность слоёв (staged-снимок)…" >&2

            # --- приманка по ВСЕМ защитам: линтер обязан краснеть на битом входе ---
            # Сторож не проверяется запуском самого себя. Но узкая приманка (только
            # битая ссылка) доказывает только C1: подмена «краснею на пропавшем файле,
            # молчу на остальном» её проходит. Поэтому фикстура ломает каждую защиту:
            # C1 — ссылка в пустоту, C2/C3 — рефлекс без раскрытия, C4 — внеканонный
            # TTL, C5 — шаг в ядре без раздела в cold-start.md. Проверяются и сводный
            # отказ, и то, что каждая защита назвала СВОЮ находку.
            CANARY="$(mktemp -d)"
            mkdir -p "$CANARY/.claude/agents/references"
            {
                printf 'Ссылка в пустоту: `references/canary-missing.md`\n'
                printf 'Рефлексы: см. `references/vpn-reflexes.md`\n'
                printf -- '- **3.8.77** выдуманный рефлекс без раскрытия\n'
                printf 'Слои: `_live/` 99 дн, `_reference/` 60 дн, `_meta/` 365 дн\n'
                printf '## 7.1 Cold Start\nШаг 0 — конфиги. Шаг 77 — выдуманный.\n## 7.2 First-Run\n'
            } > "$CANARY/CLAUDE.md"
            printf '# vpn-reflexes\n' > "$CANARY/.claude/agents/references/vpn-reflexes.md"
            printf '# cold-start\n\n## Шаг 0. Конфиги\n' > "$CANARY/.claude/agents/references/cold-start.md"

            CANARY_OUT="$(bash "$LINTER" --root "$CANARY" 2>&1)"
            CANARY_RC=$?
            CANARY_MISSED=""
            printf '%s' "$CANARY_OUT" | grep -q 'canary-missing' || CANARY_MISSED="$CANARY_MISSED C1"
            printf '%s' "$CANARY_OUT" | grep -q '3\.8\.77'      || CANARY_MISSED="$CANARY_MISSED C2/C3"
            printf '%s' "$CANARY_OUT" | grep -q 'C4:'           || CANARY_MISSED="$CANARY_MISSED C4"
            printf '%s' "$CANARY_OUT" | grep -q 'Шаг 77'        || CANARY_MISSED="$CANARY_MISSED C5"
            if [ "$CANARY_RC" -eq 0 ] || [ -n "$CANARY_MISSED" ]; then
                echo "❌ pre-commit: линтер персоны не поймал приманку по защитам:${CANARY_MISSED:- (вернул 0)}" >&2
                echo "   Сторож сломан или подменён — его зелёный на настоящем ядре ничего не значит." >&2
                FAIL=1
            fi
            rm -rf "$CANARY"

            if ! bash "$LINTER" --root "$SNAP" >&2; then
                echo >&2
                echo "❌ pre-commit: персона рассинхронизирована в том, что уходит в коммит (выжимка ↔ references)." >&2
                echo "   Синхронизируй ядро CLAUDE.md и references/ и добавь их в индекс (git add)." >&2
                FAIL=1
            fi
        fi
    fi
    rm -rf "$SNAP"

    # Честный предел: хук — не корень доверия для собственной подмены. Правку самих
    # .githooks/* этот же хук и проверяет; окончательно её охраняет только внешний
    # контур (ревью, CI из неизменяемого источника), которого здесь нет.

    # --- staged-проекция: ссылки ядра существуют В ИНДЕКСЕ, а не на диске ---
    # Линтер выше читает рабочее дерево. Новый reference, лежащий на диске, но не
    # добавленный в индекс (`git add -u` не берёт неотслеживаемые файлы), давал
    # зелёный хук и битую ссылку в коммите. Найдено сверкой 2026-08-20.
    if git cat-file -e :CLAUDE.md 2>/dev/null; then
        MISSING_IN_INDEX=""
        while IFS= read -r ref; do
            [ -z "$ref" ] && continue
            if ! git cat-file -e ":.claude/agents/$ref" 2>/dev/null; then
                MISSING_IN_INDEX="$MISSING_IN_INDEX $ref"
                continue
            fi
            # Существования мало: symlink или gitlink на месте документа тоже «есть».
            # Режим обычного файла утверждается явно (сверка 2026-08-20).
            REF_MODE="$(git ls-files --stage -- ".claude/agents/$ref" 2>/dev/null | cut -d" " -f1)"
            if [ "$REF_MODE" != "100644" ]; then
                echo "❌ pre-commit: $ref в индексе не обычный файл (режим ${REF_MODE:-неизвестен})." >&2
                FAIL=1
            fi
        done < <(git cat-file blob :CLAUDE.md | grep -oE 'references/[^[:space:]`*(),;"]+\.md' | sort -u)
        if [ -n "$MISSING_IN_INDEX" ]; then
            echo "❌ pre-commit: ядро ссылается на$MISSING_IN_INDEX — этих файлов нет в индексе." >&2
            echo "   Добавь их (git add) — иначе коммит уедет с битыми указателями." >&2
            FAIL=1
        fi
    fi
fi


# ===========================================================================
# 1b. РЕЕСТР ФИЛЬТРА — схема (только если коммит трогает todos/filter-log.md)
# ===========================================================================
case "$STAGED" in *"todos/filter-log.md"*)
    FLV="$ROOT/scripts/validate-filter-log.sh"
    if [ ! -f "$FLV" ]; then
        echo "❌ pre-commit: реестр фильтра меняется, но валидатора нет ($FLV)." >&2
        FAIL=1
    else
        # По staged-снимку: на диске может лежать исправленный реестр, а в коммит
        # уйти сломанный — тот же класс, что и с линтером персоны.
        FLSNAP="$(mktemp -d)"
        if ! git checkout-index -a --prefix="$FLSNAP/" 2>/dev/null; then
            echo "❌ pre-commit: не удалось выгрузить индекс для проверки реестра." >&2
            FAIL=1
        elif ! bash "$FLV" --root "$FLSNAP" >&2; then
            echo "❌ pre-commit: реестр применений фильтра нарушает схему (ADR-0028)." >&2
            FAIL=1
        fi
        rm -rf "$FLSNAP"
    fi
    ;;
esac
# ===========================================================================
# 2. ЗНАНИЯ — целостность базы (только если коммит трогает .claude/knowledge/)
# ===========================================================================
KNOWLEDGE_TOUCHED=0
case "$STAGED" in *".claude/knowledge/"*) KNOWLEDGE_TOUCHED=1 ;; esac

if [ "$KNOWLEDGE_TOUCHED" -eq 1 ]; then
    VALIDATOR="$ROOT/scripts/validate-knowledge.py"
    # Ищем РАБОЧИЙ интерпретатор, а не просто наличие: на Windows `python3` часто —
    # нерабочий WindowsApps-стаб (Store-редирект, exit 49), а реальный Python зовётся
    # `python`. Поэтому проверяем исполнимость (`-c 'import sys'`), не `command -v`.
    PYBIN=""
    for _py in python3 python; do
        if command -v "$_py" >/dev/null 2>&1 && "$_py" -c 'import sys' >/dev/null 2>&1; then
            PYBIN="$_py"; break
        fi
    done
    if [ ! -f "$VALIDATOR" ]; then
        echo "⚠️  pre-commit: knowledge меняется, но валидатор не найден ($VALIDATOR) — пропускаю." >&2
    elif [ -z "$PYBIN" ]; then
        echo "⚠️  pre-commit: рабочий python не найден — пропускаю валидацию knowledge." >&2
        echo "   Для строгой проверки целостности базы знаний установи python3 (+ pip install pyyaml)." >&2
    else
        echo "pre-commit: коммит трогает knowledge → проверяю целостность базы ($PYBIN)…" >&2
        if ! ( cd "$ROOT" && "$PYBIN" "$VALIDATOR" >&2 ); then
            echo >&2
            echo "❌ pre-commit: база знаний не прошла валидацию (frontmatter / битые ссылки)." >&2
            echo "   Почини по выводу выше. Обход (редко): git commit --no-verify" >&2
            FAIL=1
        fi
    fi
fi

if [ "$FAIL" -ne 0 ]; then
    echo >&2
    echo "🔴 pre-commit ЗАБЛОКИРОВАН — см. причины выше." >&2
fi
exit "$FAIL"
