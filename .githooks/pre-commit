#!/usr/bin/env bash
# .githooks/pre-commit — версионируемый pre-commit hook репо sysadmin.
#
# ЗАЧЕМ. Две независимые проверки целостности перед коммитом:
#  1) ПЕРСОНА (CLAUDE.md ↔ references/*.md; ADR-0015) — рассинхрон слоёв = неправильное
#     действие агента на старте (инциденты v1.9.1–v1.9.3). + бюджет ядра CLAUDE.md (ADR-0016).
#  2) ЗНАНИЯ (.claude/knowledge/) — целостность базы: валидный frontmatter (иначе файл
#     невидим для контроля свежести), битые путевые ссылки, сироты (ADR-0003/0006).
#
# Хук версионируется (лежит в репо), активируется один раз:
#   git config core.hooksPath .githooks
# Эту строку добавляют sysadmin-init / bootstrap-new-server при настройке.
#
# Обход в исключительном случае (НЕ по привычке): git commit --no-verify

set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
STAGED="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)"
FAIL=0

# ===========================================================================
# 1. ПЕРСОНА — бюджет ядра + синхрон слоёв (только если коммит трогает персону)
# ===========================================================================
PERSONA_TOUCHED=0
case "$STAGED" in *"CLAUDE.md"*)                  PERSONA_TOUCHED=1 ;; esac  # ядро (ADR-0015)
case "$STAGED" in *".claude/agents/sysadmin.md"*) PERSONA_TOUCHED=1 ;; esac  # legacy/заглушка
case "$STAGED" in *".claude/agents/references/"*) PERSONA_TOUCHED=1 ;; esac

if [ "$PERSONA_TOUCHED" -eq 1 ]; then
    # --- бюджет ядра CLAUDE.md (ADR-0016, анти-храповик) -------------------
    CLAUDE_BUDGET_BYTES=42000
    CLAUDEMD="$ROOT/CLAUDE.md"
    case "$STAGED" in
        *"CLAUDE.md"*)
            if [ -f "$CLAUDEMD" ]; then
                # Канонический размер — тот, что уходит в репозиторий: staged-блоб уже
                # прошёл clean-фильтр, значит LF. Сырой `wc -c` рабочей копии на Windows
                # завышает на число строк (CRLF) и делает порог платформозависимым —
                # правка, проходящая на сервере, падала бы на ноутбуке (ADR-0023).
                BYTES="$(git cat-file -s :CLAUDE.md 2>/dev/null)"
                [ -n "$BYTES" ] || BYTES="$(tr -d '\r' < "$CLAUDEMD" | wc -c | tr -d ' ')"
                if [ "$BYTES" -gt "$CLAUDE_BUDGET_BYTES" ]; then
                    echo "❌ pre-commit: CLAUDE.md = ${BYTES} Б > бюджет ${CLAUDE_BUDGET_BYTES} Б (ADR-0016)." >&2
                    echo "   Ядро грузится при каждом старте. Вынеси часть в references/ («одно входит — одно выходит»)," >&2
                    echo "   либо подними бюджет осознанно через ADR. Обход (редко): git commit --no-verify" >&2
                    FAIL=1
                fi
            fi
            ;;
    esac

    # --- линтер согласованности слоёв -------------------------------------
    LINTER="$ROOT/.claude/skills/_lib/check-persona-sync.sh"
    if [ ! -f "$LINTER" ]; then
        echo "⚠️  pre-commit: персона меняется, но линтер не найден ($LINTER) — пропускаю проверку." >&2
    else
        echo "pre-commit: коммит трогает персону → проверяю согласованность слоёв…" >&2
        if ! bash "$LINTER" --root "$ROOT" >&2; then
            echo >&2
            echo "❌ pre-commit: персона рассинхронизирована (выжимка ↔ references)." >&2
            echo "   Синхронизируй ядро CLAUDE.md и references/ (см. CLAUDE.md «персона двухслойна»)." >&2
            FAIL=1
        fi
    fi
fi

# ===========================================================================
# 2. ЗНАНИЯ — целостность базы (только если коммит трогает .claude/knowledge/)
# ===========================================================================
KNOWLEDGE_TOUCHED=0
case "$STAGED" in *".claude/knowledge/"*) KNOWLEDGE_TOUCHED=1 ;; esac

if [ "$KNOWLEDGE_TOUCHED" -eq 1 ]; then
    VALIDATOR="$ROOT/scripts/validate-knowledge.py"
    # Ищем РАБОЧИЙ интерпретатор, а не просто наличие: на Windows `python3` часто —
    # нерабочий WindowsApps-стаб (Store-редирект, exit 49), а реальный Python зовётся
    # `python`. Поэтому проверяем исполнимость (`-c 'import sys'`), не `command -v`.
    PYBIN=""
    for _py in python3 python; do
        if command -v "$_py" >/dev/null 2>&1 && "$_py" -c 'import sys' >/dev/null 2>&1; then
            PYBIN="$_py"; break
        fi
    done
    if [ ! -f "$VALIDATOR" ]; then
        echo "⚠️  pre-commit: knowledge меняется, но валидатор не найден ($VALIDATOR) — пропускаю." >&2
    elif [ -z "$PYBIN" ]; then
        echo "⚠️  pre-commit: рабочий python не найден — пропускаю валидацию knowledge." >&2
        echo "   Для строгой проверки целостности базы знаний установи python3 (+ pip install pyyaml)." >&2
    else
        echo "pre-commit: коммит трогает knowledge → проверяю целостность базы ($PYBIN)…" >&2
        if ! ( cd "$ROOT" && "$PYBIN" "$VALIDATOR" >&2 ); then
            echo >&2
            echo "❌ pre-commit: база знаний не прошла валидацию (frontmatter / битые ссылки)." >&2
            echo "   Почини по выводу выше. Обход (редко): git commit --no-verify" >&2
            FAIL=1
        fi
    fi
fi

if [ "$FAIL" -ne 0 ]; then
    echo >&2
    echo "🔴 pre-commit ЗАБЛОКИРОВАН — см. причины выше." >&2
fi
exit "$FAIL"
