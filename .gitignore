# Личная конфигурация агента — НИКОГДА не коммитится в публичный репо.
# Содержит имя оператора, реальные пути к проектам, менеджер паролей (ADR-0013).
agent-config.json
# Личная карта инфры — если оператор работает прямо в sysadmin/ (ADR-0013).
infra-config.json

# Публичные шаблоны и схемы — коммитятся (negation override правила выше)
!agent-config.example.json
!agent-config.schema.json
!infra-config.example.json
!infra-config.schema.json

# Старые имена (до ADR-0013) — переходный период, удаляются после миграции.
sysadmin-config.json
!sysadmin-config.example.json
!sysadmin-config.schema.json

# Мусор macOS
.DS_Store
._*

# Редакторские
.vscode/
.idea/
*.swp

# Claude Code служебные файлы
.claude/scheduled_tasks.lock

# Метка последней проверки обновлений (у каждого оператора своя)
.update-check

# Результаты прогона evals — артефакты сессии, не часть репо.
# Раннер — scripts/run-evals.sh (см. ADR-0004).
.eval-results/

# Временные артефакты ревизий и audit-сессий (Explore-агенты,
# промежуточные отчёты) — не часть репо.
.audit-tmp/
