{
  "$schema": "./infra-config.schema.json",
  "version": "1.0",
  "map": {
    "vpn": "inventory/hosts/my-server/vpn-3xui.md",
    "web": "inventory/hosts/my-server/services.md",
    "databases": "inventory/hosts/my-server/databases.md",
    "domains": "inventory/shared/domains.md"
  },
  "monitoring": {
    "enabled": false
  },
  "backups": {
    "enabled": false
  },
  "notifications": {
    "telegram": {
      "enabled": false
    }
  },
  "servers": [
    {
      "alias": "my-server",
      "ssh_alias": "my-server",
      "role": "production",
      "domain": "example.com"
    }
  ],
  "vpn": {
    "enabled": false,
    "panel_url": null,
    "panel_web_base_path": null,
    "server_role": null,
    "server_proxy_enabled": false,
    "upstream_kind": "none",
    "default_reality_dest": "www.cloudflare.com"
  }
}
